# OpsCockpit collect — systemd timer template (REFERENCE ONLY).
#
# Installed during the deployment phase (NOT by this repository or CI).
# Runs `opscockpit collect` roughly every 30 seconds, starting shortly after
# boot. Persistent=false (no catch-up on long downtime).

[Unit]
Description=OpsCockpit runtime collect timer
Requires=opscockpit-collect.service

[Timer]
OnBootSec=10s
OnUnitActiveSec=30s
Persistent=false
AccuracySec=5s

[Install]
WantedBy=timers.target
