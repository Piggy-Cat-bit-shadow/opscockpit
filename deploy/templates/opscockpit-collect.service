# OpsCockpit collect — systemd unit template (REFERENCE ONLY).
#
# Installed during the deployment phase (NOT by this repository or CI).
# A short-lived root oneshot that refreshes state.json. Not a resident agent.

[Unit]
Description=OpsCockpit runtime collect (refresh state.json)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root: collect reads /proc, /sys, cgroup v2, and runs `ss`, `systemctl show`,
# UFW, iptables, ip, docker/nginx when present. It runs briefly and exits.
User=root

ExecStart=/usr/local/bin/opscockpit collect \
  -services /etc/opscockpit/services.yaml \
  -out /var/lib/opscockpit/state.json \
  -lock /run/opscockpit/collect.lock

# The collect lock /run/opscockpit/collect.lock is advisory: concurrent
# collects (timer + restart-triggered) are handled by the lock, which waits
# briefly or exits cleanly.
